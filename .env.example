# ── Claude API ────────────────────────────────────────
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=xx

# ── ngrok ─────────────────────────────────────────────
# Start ngrok with: ngrok http 3001
# Then paste the https URL here (no trailing slash)
NGROK_URL=xx

# ── GitHub Actions auth ───────────────────────────────
# Add this as a GitHub Actions secret called SECUREPULSE_API_KEY
SECUREPULSE_API_KEY=xx

# ── OWASP Dependency-Check (SCA) ──────────────────────
# Add this as a GitHub Actions secret called NVD_API_KEY
NVD_API_KEY=xx

# ── GitHub fix PRs ─────────────────────────────────────
GITHUB_TOKEN=xx
GITHUB_OWNER=arslanahmedshah99
GITHUB_REPO=CPS_7007_SecurePulse

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=securepulse
POSTGRES_USER=securepulse
POSTGRES_PASSWORD=localdevpassword

# ── Backend ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────
VITE_API_URL=http://localhost:3001
